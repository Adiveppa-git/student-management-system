# =============================================================================
# Student Management System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize for your local development or deployment:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your actual .env file or real secrets to version control.
# - The values below are non-sensitive templates and placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB Connection Configuration
# -----------------------------------------------------------------------------
# Local development default:
MONGO_URI=mongodb://localhost:27017/

# For authenticated or production MongoDB deployments (replace placeholders):
# MONGO_URI=mongodb://<db_user>:<db_password>@<db_host>:<db_port>/<database_name>?authSource=admin

# Primary database name configuration (takes precedence over DB_NAME):
DATABASE_NAME=student_db

# Legacy fallback for backward-compatibility with older deployment setups:
# DB_NAME=student_db

# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Defaults to explicit local development servers if not specified:
#   http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
#
# Production frontend example (do NOT use wildcards with credentials):
# CORS_ORIGINS=https://your-college-domain.edu,https://admin.your-college-domain.edu
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# -----------------------------------------------------------------------------
# Application Server Settings (Uvicorn / FastAPI)
# -----------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
